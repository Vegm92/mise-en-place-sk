{
	"name": "mise-en-place-sk",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"dev:all": "concurrently -n web,worker -c blue,green \"pnpm dev\" \"pnpm worker\"",
		"build": "vite build && pnpm build:worker",
		"build:worker": "vite build --config vite.worker.config.ts",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"test": "vitest run",
		"test:watch": "vitest",
		"synth:generate": "cd synth && python -m synth generate --count 50 --difficulty mixed --output ./output/run_$(date +%Y%m%d)",
		"synth:bench": "cd synth && python -m synth bench $(ls -dt output/run_* 2>/dev/null | head -1) --backend gemini",
		"synth:bench:ci": "cd synth && python -m synth bench $(ls -dt output/run_* 2>/dev/null | head -1) --backend gemini --threshold 0.80",
		"synth:e2e": "npm run synth:generate && npm run synth:bench",
		"synth:validate": "cd synth && python -m synth validate-output $(ls -dt output/run_* 2>/dev/null | head -1)",
		"db:generate": "drizzle-kit generate",
		"db:migrate": "drizzle-kit migrate",
		"db:push": "drizzle-kit push",
		"db:studio": "drizzle-kit studio",
		"db:seed-demo": "node scripts/seed-demo.mjs",
		"worker": "vite-node -r dotenv/config --config vite.worker.config.ts src/worker.ts",
		"worker:prod": "node build/worker.js"
	},
	"devDependencies": {
		"@sveltejs/adapter-auto": "^7.0.0",
		"@sveltejs/adapter-node": "^5.5.4",
		"@sveltejs/kit": "^2.50.2",
		"@sveltejs/vite-plugin-svelte": "^6.2.4",
		"@tailwindcss/vite": "^4.2.2",
		"@types/pdf-parse": "^1.1.4",
		"@vitest/coverage-v8": "^3.0.0",
		"concurrently": "^10.0.3",
		"drizzle-kit": "^0.31.10",
		"playwright": "^1.60.0",
		"shadcn-svelte": "^1.2.7",
		"svelte": "^5.54.0",
		"svelte-check": "^4.4.2",
		"tailwindcss": "^4.2.2",
		"typescript": "^5.9.3",
		"vite": "^7.3.1",
		"vite-node": "^6.0.0",
		"vitest": "^3.0.0"
	},
	"dependencies": {
		"@google/genai": "^1.50.1",
		"@internationalized/date": "^3.12.0",
		"@lucide/svelte": "^1.8.0",
		"@sentry/sveltekit": "^10.56.0",
		"@supabase/ssr": "^0.6.1",
		"@supabase/supabase-js": "^2.49.8",
		"@upstash/ratelimit": "^2.0.5",
		"@upstash/redis": "^1.34.9",
		"bits-ui": "^2.17.3",
		"chart.js": "^4.5.1",
		"clsx": "^2.1.1",
		"dotenv": "^17.4.2",
		"drizzle-orm": "^0.45.2",
		"lucide-svelte": "^0.577.0",
		"pdf-parse": "^1.1.1",
		"pg-boss": "^12.18.3",
		"postgres": "^3.4.9",
		"resend": "^6.12.4",
		"stripe": "^22.2.0",
		"tailwind-merge": "^3.5.0",
		"tailwind-variants": "^3.2.2"
	}
}
