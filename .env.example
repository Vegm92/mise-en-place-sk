DATABASE_URL=mise_en_place.db
UPLOADS_DIR=uploads
SK_SESSIONS_DIR=data/sk_sessions
GEMINI_API_KEY=

# BetterAuth — generate secret with: openssl rand -hex 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Initial admin account (seeded on first startup if both are set)
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=changeme

# Google OAuth (optional — leave blank to disable the Google button)
# Create credentials at: https://console.cloud.google.com/apis/credentials
# Authorised redirect URI: {BETTER_AUTH_URL}/api/auth/callback/google
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Comma-separated list of emails allowed to sign in via Google OAuth.
# Leave blank to allow any Google account (only safe on a private network).
# Example: AUTH_ALLOWED_EMAILS=alice@example.com,bob@example.com
AUTH_ALLOWED_EMAILS=
