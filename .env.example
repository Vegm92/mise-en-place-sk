# --- Database ---
# Direct connection — used by drizzle-kit migrations and pg-boss worker
# Railway Postgres: railway variables --service Postgres --kv
DATABASE_URL=postgresql://postgres:[password]@postgres.railway.internal:5432/railway

# Optional: Session Mode pooler URL for the Drizzle ORM runtime queries.
# Recommended for multi-replica deployments. Falls back to DATABASE_URL when unset.
# DATABASE_POOL_URL=

# Encrypted (require) by default. Railway's managed Postgres cert is issued for
# CN=localhost only, so its SAN never matches the connecting hostname — true
# verify-full hostname checking can't pass against it. Set DATABASE_CA_CERT to
# the pinned root-ca cert to verify the chain (still no hostname check) if you
# need stronger-than-`require` guarantees; see src/lib/server/db-ssl.ts.
DATABASE_SSL_MODE=require
# DATABASE_CA_CERT=

# Fail fast when the database host is unreachable. Without a connect timeout the
# driver waits indefinitely and every page that queries the DB hangs instead of
# rendering a degraded state.
DB_CONNECT_TIMEOUT_SECONDS=10
# Server-side cap on any single statement, in ms.
DB_STATEMENT_TIMEOUT_MS=15000

# Optional: database used by DB-backed tests. Overrides DATABASE_URL for
# `pnpm test` only, so the test suite and the app can never share a connection
# string by accident. DB-backed tests INSERT and DELETE real rows, so they run
# only when the URL is local (localhost / 127.0.0.1 / ::1 / host.docker.internal);
# against any other host they skip with a loud notice.
# DATABASE_TEST_URL=postgresql://postgres@127.0.0.1:5432/mep_test

# Escape hatch: run DB-backed tests against a NON-local database. Destructive —
# only set this for a throwaway/branch database, never for production.
# ALLOW_REMOTE_DB_TESTS=1

# --- Auth (Auth.js / SvelteKitAuth) ---
# Session/JWT signing secret. Generate with: openssl rand -base64 32
AUTH_SECRET=
# Google OAuth — from Google Cloud Console → APIs & Services → Credentials.
# Authorized redirect URI: {origin}/auth/callback/google (Auth.js's SvelteKit
# adapter always mounts at /auth, regardless of where any route file lives).
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# --- File storage ---
# 'local' (default) writes files to UPLOADS_DIR on local disk.
# 'railway' writes to a Railway Bucket (S3-compatible) — set the AWS_* vars
# below from `railway bucket credentials`.
#
# IMPORTANT (issue #285): web and worker are two processes. The web process
# writes the upload, the worker reads it back to extract it. With
# STORAGE_DRIVER=local they MUST share the same directory on a persistent
# volume — docker-compose.yml mounts one at /app/uploads for both services.
# If your platform cannot give both processes the same disk (separate
# Railway/Render/Fly services), use STORAGE_DRIVER=railway.
STORAGE_DRIVER=local
UPLOADS_DIR=uploads

# Required only when STORAGE_DRIVER=railway. Get with: railway bucket credentials
AWS_ENDPOINT_URL=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_BUCKET_NAME=
AWS_DEFAULT_REGION=
AWS_S3_URL_STYLE=path

# --- Reverse proxy / client IP ---
# adapter-node resolves getClientAddress() from the socket peer unless told
# otherwise. Behind nginx/Caddy/a load balancer that is the proxy's IP, so every
# visitor shares one rate-limit bucket (issue #223). Set these when a proxy
# terminates TLS; XFF_DEPTH = number of trusted proxies in front of the app.
# Leave both unset when the Node process is directly internet-facing.
ADDRESS_HEADER=x-forwarded-for
XFF_DEPTH=1

# --- Gemini AI ---
GEMINI_API_KEY=
# Gemini model — update here when Google deprecates the current one
# https://ai.google.dev/gemini-api/docs/models
GEMINI_MODEL=gemini-2.5-flash
# Per-request wall-clock timeout for extraction (ms). When it fires, the
# in-flight Gemini request is aborted (not just abandoned) so it stops holding
# a socket and a Gemini concurrency slot. Lower it during a Gemini incident to
# fail fast instead of backing the sequential worker up.
GEMINI_TIMEOUT_MS=60000

# --- Chat rate limit ---
# Requests per minute per IP
CHAT_RATE_LIMIT_RPM=20

# --- Rate limiting / distributed coordination (optional) ---
# Upstash Redis backs rate limiting across multiple web instances. If unset,
# rate limiting falls back to an in-memory token bucket (per-process only).
# NOTE: the extraction concurrency semaphore (MAX_CONCURRENT_EXTRACTIONS) is
# in-process and therefore single-instance only — running multiple worker
# processes multiplies the effective concurrency against Gemini.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# --- Invoice extraction ---
# Max parallel Gemini extraction calls PER worker process (in-process semaphore).
MAX_CONCURRENT_EXTRACTIONS=3

# --- Observability ---
# Leave empty to disable Sentry (safe for local dev)
SENTRY_DSN=
VITE_SENTRY_DSN=
# Auth token for source map upload (build-time) and the /admin/errors + /admin/health
# Sentry API calls (runtime). Create in Sentry: Settings -> Auth Tokens, scopes
# project:read, event:read, org:read. Leave empty to disable both — both degrade
# to a "not configured" state (no 500s) rather than erroring.
SENTRY_AUTH_TOKEN=
SENTRY_ORG=
SENTRY_PROJECT=
# Set to the deployed git SHA so Sentry can bisect issues to a release. Optional.
SENTRY_RELEASE=
VITE_SENTRY_RELEASE=

# --- Billing (Stripe) ---
# Get from: dashboard.stripe.com → Developers → API keys
# Local dev: always sk_test_... here. Live keys (rk_live_.../sk_live_...) go in
# the hosting platform's env var store (Railway), never in this file or .env.
STRIPE_SECRET_KEY=sk_test_...
# One monthly price ID per paid tier (dashboard.stripe.com → Products → Price ID).
# All three are required for their tier's checkout button to work; an unset tier
# returns a "plan not available" error on /billing instead of 500 (issue #286).
# Rotating a price in Stripe means updating it here too — the webhook logs an
# error (and Sentry event) when a subscription arrives with an unknown price ID.
STRIPE_PRICE_ID_STARTER=price_...
STRIPE_PRICE_ID_PRO=price_...
STRIPE_PRICE_ID_BUSINESS=price_...
# Legacy single-price variable — only used as a fallback for the Starter tier.
STRIPE_PRICE_ID=price_...
# Webhook signing secret — set the endpoint to {your-origin}/api/stripe-webhook
STRIPE_WEBHOOK_SECRET=whsec_...
# Monthly list price per tier, in euros, used by /admin/revenue to price MRR.
# Optional: unset, each tier falls back to PROVISIONAL_PRICE in
# src/lib/billing-plans.ts (the same table the public pricing page renders).
# Set these when the billed price diverges from the published one, otherwise
# MRR, ARPA, ACV, LTV and the LTV/CAC ratio are all computed off a stale number.
PLAN_PRICE_STARTER_EUR=
PLAN_PRICE_PRO_EUR=
PLAN_PRICE_BUSINESS_EUR=

# --- Email (Resend) ---
# Get from: resend.com → API Keys
RESEND_API_KEY=re_...
# Verified sender domain; update after domain verification in Resend
EMAIL_FROM=Mise en Place <noreply@miseenplace.app>
# Legal footer on outgoing emails (razón social, dirección fiscal, NIF).
# Left blank, that footer line is omitted rather than shown with placeholder text.
COMPANY_LEGAL_NAME=
COMPANY_ADDRESS=
COMPANY_NIF=

# --- WhatsApp Cloud API (Meta) ---
# Set up at: developers.facebook.com/apps → WhatsApp → API Setup
# WHATSAPP_ACCESS_TOKEN    — Permanent system user token (keep secret)
# WHATSAPP_PHONE_NUMBER_ID — Phone Number ID from the API Setup page
# WHATSAPP_VERIFY_TOKEN    — Any secret string; used to verify the webhook in Meta Console
# WHATSAPP_APP_SECRET      — App secret (App Dashboard → Settings → Basic). Used to
#                            verify X-Hub-Signature-256 on inbound POSTs. REQUIRED in
#                            production; without it the webhook cannot authenticate Meta.
# WHATSAPP_API_VERSION     — Graph API version (default v25.0). Meta expires each
#                            version ~2 years after release and calls to an expired
#                            one fail outright — review this at every upgrade.
# WHATSAPP_DISPLAY_NUMBER  — The bot's own number, in a dialable form (e.g.
#                            +34 612 345 678). WHATSAPP_PHONE_NUMBER_ID is an
#                            opaque id, so without this the app cannot tell staff
#                            where to send invoices — Settings shows the number,
#                            a wa.me link and a printable QR only when it is set.
#   Webhook URL: https://your-domain.com/api/whatsapp/webhook
#   Subscribed fields: messages
# Authorise staff numbers in the app: Settings → "Facturas por WhatsApp" (owner only).
# APP_BASE_URL             — Public origin used to build the /batch/[id] link sent back
#                            over WhatsApp when an inbound invoice is received
#                            (e.g. https://app.miseenplace.app).
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_API_VERSION=v25.0
APP_BASE_URL=
WHATSAPP_DISPLAY_NUMBER=

# --- Initial admin account (seeded on first db:seed run) ---
AUTH_ADMIN_EMAIL=admin@example.com
AUTH_ADMIN_PASSWORD=changeme
AUTH_ADMIN_RESTAURANT_NAME=My Restaurant
