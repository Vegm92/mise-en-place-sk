<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<link rel="stylesheet" href="{{ css_path }}/base.css">
<style>@page { size: A4; margin: 0; }</style>
</head>
<body>

{% if watermark %}
<div style="position:fixed;top:40%;left:10%;transform:rotate(-35deg);
  font-size:72pt;font-weight:900;color:rgba(180,0,0,0.15);
  white-space:nowrap;z-index:999;pointer-events:none;">{{ watermark }}</div>
{% endif %}

<div class="header">
  <div class="supplier-block">
    <div class="supplier-name">{{ spec.supplier.name }}</div>
    <div class="supplier-cif">{{ cif_label }}: {{ spec.supplier.cif }}</div>
    <div class="supplier-address">
      {{ spec.supplier.address.street }}<br>
      {{ spec.supplier.address.postal_code }} {{ spec.supplier.address.city }}<br>
      Tel: {{ spec.supplier.phone }} · {{ spec.supplier.email }}
    </div>
  </div>
  <div class="doc-block">
    <div class="doc-type">Factura</div>
    <div class="doc-number">Nº {{ spec.invoice_number }}</div>
    <div class="doc-dates">
      Fecha emisión: {{ date_format(spec.invoice_date) }}<br>
      {% if spec.due_date %}Fecha vencimiento: {{ date_format(spec.due_date) }}{% endif %}
    </div>
  </div>
</div>

<hr class="divider">

<div class="parties">
  <div class="buyer-block">
    <div class="section-title">Cliente / Destinatario</div>
    <div class="party-name">{{ spec.buyer_name }}</div>
    <div class="party-detail">
      {{ cif_label }}: {{ spec.buyer_cif }}<br>
      {{ spec.buyer_address.street }}<br>
      {{ spec.buyer_address.postal_code }} {{ spec.buyer_address.city }}
    </div>
  </div>
</div>

<table>
  <thead>
    <tr>
      <th style="width:45%">Descripción</th>
      <th class="right" style="width:10%">Cant.</th>
      <th style="width:8%">Ud.</th>
      <th class="right" style="width:14%">P.U. ({{ currency_symbol }})</th>
      <th class="right" style="width:10%">IVA</th>
      <th class="right" style="width:13%">Importe ({{ currency_symbol }})</th>
    </tr>
  </thead>
  <tbody>
    {% for item in spec.items %}
    <tr>
      <td>{{ item.description }}</td>
      <td class="right">{{ format_qty(item.quantity) }}</td>
      <td class="center">{{ item.unit }}</td>
      <td class="right">{{ format_money(item.unit_price) }}</td>
      <td class="right">{{ format_pct(item.iva_rate) }}</td>
      <td class="right">{{ format_money(item.total_price) }}</td>
    </tr>
    {% endfor %}
  </tbody>
</table>

<div style="display:flex;justify-content:space-between;align-items:flex-start;">
  <div style="flex:1;">
    {% if spec.notes %}<div class="notes">{{ spec.notes }}</div>{% endif %}
  </div>
  <div class="totals-section">
    {% for b in spec.totals.iva_breakdown %}
    <div class="totals-row">
      <span>Base imp. IVA {{ format_pct(b.rate) }}</span>
      <span>{{ format_money(b.base) }} {{ currency_symbol }}</span>
    </div>
    <div class="totals-row">
      <span>Cuota IVA {{ format_pct(b.rate) }}</span>
      <span>{{ format_money(b.cuota) }} {{ currency_symbol }}</span>
    </div>
    {% endfor %}
    <div class="totals-row grand">
      <span>TOTAL</span>
      <span>{{ format_money(spec.totals.displayed_grand_total) }} {{ currency_symbol }}</span>
    </div>
  </div>
</div>

<div class="footer">
  Documento generado electrónicamente · {{ spec.supplier.name }} · {{ spec.supplier.cif }}
</div>

</body>
</html>
