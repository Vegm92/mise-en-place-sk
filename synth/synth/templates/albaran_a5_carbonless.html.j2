<!DOCTYPE html>
<html lang="es">
<head>
<meta charset="UTF-8">
<style>
@page { size: A5; margin: 8mm 10mm; }
* { box-sizing: border-box; margin: 0; padding: 0; }
body { font-family: Arial, sans-serif; font-size: 8.5pt;
  background: #eef4ff; color: #111; }
.header { border-bottom: 2px solid #336; padding-bottom: 2mm; margin-bottom: 3mm;
  display: flex; justify-content: space-between; }
.sup { font-weight: bold; font-size: 10pt; color: #336; }
.sup-sub { font-size: 7pt; color: #555; margin-top: 0.5mm; }
.alb-ref { text-align: right; }
.alb-title { font-size: 12pt; font-weight: bold; color: #336; }
.alb-num { font-size: 8pt; color: #555; }
.meta { font-size: 8pt; margin-bottom: 2mm; display: flex; gap: 6mm; }
.meta span { font-weight: bold; }
table { width: 100%; border-collapse: collapse; font-size: 8pt; }
thead th { background: #336; color: #fff; padding: 1.5mm 2mm; text-align: left; }
thead th.right { text-align: right; }
tbody td { padding: 1.2mm 2mm; border-bottom: 1px solid #c0cfe8; }
tbody td.right { text-align: right; }
tbody tr:nth-child(even) { background: rgba(51,102,204,0.05); }
.sig-box { margin-top: 5mm; display: flex; justify-content: space-between; }
.sig-block { border: 1px solid #999; width: 40mm; height: 12mm; padding: 1mm;
  font-size: 6.5pt; color: #888; }
.total-box { border: 2px solid #336; padding: 1.5mm 3mm; font-size: 9pt; font-weight: bold; }
</style>
</head>
<body>

{% if watermark %}
<div style="position:fixed;top:35%;left:5%;transform:rotate(-35deg);
  font-size:52pt;font-weight:900;color:rgba(0,0,150,0.1);white-space:nowrap;">{{ watermark }}</div>
{% endif %}

<div class="header">
  <div>
    <div class="sup">{{ spec.supplier.name }}</div>
    <div class="sup-sub">{{ spec.supplier.address.street }} · {{ spec.supplier.address.city }}<br>
    CIF: {{ spec.supplier.cif }} · {{ spec.supplier.phone }}</div>
  </div>
  <div class="alb-ref">
    <div class="alb-title">ALBARÁN</div>
    <div class="alb-num">Nº {{ spec.albaran_number }}</div>
  </div>
</div>

<div class="meta">
  <div>Fecha entrega: <span>{{ date_format(spec.delivery_date) }}</span></div>
  <div>Cliente: <span>{{ spec.buyer_name }}</span></div>
</div>

<table>
  <thead>
    <tr>
      <th style="width:50%">Artículo / Descripción</th>
      <th class="right" style="width:12%">Cant.</th>
      <th style="width:9%">Ud.</th>
      {% if spec.has_prices %}
      <th class="right" style="width:14%">P.U. (€)</th>
      <th class="right" style="width:15%">Importe (€)</th>
      {% endif %}
    </tr>
  </thead>
  <tbody>
    {% for item in spec.items %}
    <tr>
      <td>{{ item.description }}</td>
      <td class="right">{{ format_qty(item.quantity) }}</td>
      <td>{{ item.unit }}</td>
      {% if spec.has_prices %}
      <td class="right">{{ format_money(item.unit_price) if item.unit_price else '-' }}</td>
      <td class="right">{{ format_money(item.total_price) if item.total_price else '-' }}</td>
      {% endif %}
    </tr>
    {% endfor %}
  </tbody>
</table>

<div class="sig-box">
  <div>
    <div class="sig-block">Firma recepción:<br><br><br></div>
    <div style="font-size:6.5pt;color:#888;margin-top:0.5mm;">Conformidad mercancía recibida</div>
  </div>
  {% if spec.has_total and spec.has_prices %}
  <div class="total-box">
    TOTAL: {{ format_money(spec.items | sum(attribute='total_price')) }} €
    <div style="font-size:7pt;font-weight:normal;">(sin IVA — factura pendiente)</div>
  </div>
  {% endif %}
</div>

</body>
</html>
